# GENERATED by tools/make_env_example.py from this folder's .env.
# Do not hand-edit: edit .env, then regenerate. Secret values are blanked.
# Copy to .env and fill in every empty value.
# ═══════════════════════════════════════════════════════════════════════════
# Content Poster — environment  (REAL VALUES · SELF-CONTAINED)
# ═══════════════════════════════════════════════════════════════════════════
# This file is complete on its own: this agent deploys independently and reads
# nothing from outside its own folder.
#
# Production mirror: the Modal secret `wizcodes-content` (see deploy.ps1).
#
# The cost of self-contained files is DRIFT — the same key with different
# values in different folders is now possible. `python shared/check_env.py`
# compares the cross-agent keys and fails on any mismatch. Run it after every
# credential rotation; that is the guard rail this layout trades for.
# ═══════════════════════════════════════════════════════════════════════════

# ── Claude-compatible proxy (ClaudeStore) ──
# The Cloudflare in front of it rejects any request whose User-Agent does not
# look like a CLI, and its injection guard refuses prompts phrased as override
# commands. Both handled in wizcore.llm.client — never re-implement per agent.
ANTHROPIC_BASE_URL=https://api3.claudestore.store
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4.6
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4.5
ANTHROPIC_STRATEGY_MODEL=claude-opus-4-8

# ── Neon Postgres (Postgres 18) ──
# Shared database, isolated by schema. This agent owns `content.*` and
# checkpoints into `cp_ckpt`.
NEON_DATABASE_URL=
LANGGRAPH_CHECKPOINT_SCHEMA=cp_ckpt

# ── Telegram ──
# One bot across all agents. Telegram allows exactly ONE webhook URL per bot,
# so the URL belongs to agent_hub; this agent never calls setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Optional forum topic id, so approvals don't scroll away under lead alerts.
TELEGRAM_TOPIC_CONTENT=
TELEGRAM_TOPIC_ALERTS=
# Namespaces this agent's callback_data ("cp:approve:<run_id>") so the router
# can tell whose button was pressed.
TELEGRAM_CALLBACK_PREFIX=cp

# ── Site repo (grounding facts, READ-ONLY) ──
# TODO — CREATE. A fine-grained PAT, Contents: READ ONLY, scoped to this repo
# alone. Deliberately NOT the blog/case-study PUBLISH_TOKEN: this agent has no
# business being able to commit to the website.
SITE_REPO=dkcodes121617/wizcodes_main_website
SITE_REPO_BRANCH=main
SITE_READ_TOKEN=

# ── Cloudflare R2 (key prefix: social/) ──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ENDPOINT=
R2_BUCKET_NAME=wizcodes-ai-images
R2_KEY_PREFIX=
# TODO — CREATE. Enable the bucket's public r2.dev URL or attach a subdomain.
# REQUIRED: Meta's publish API FETCHES the image by URL. An unreachable bucket
# fails every Facebook and Instagram post.
R2_PUBLIC_BASE_URL=https://pub-058bcb53a480447eaefd881835c363d8.r2.dev

# ── Groq (free tier) ──
# TODO — CREATE at console.groq.com, no card. Fallback drafting only for this
# agent; the Claude proxy writes the copy.
GROQ_API_KEY=

# ── Behaviour ──
LOG_LEVEL=INFO
# Master kill switch: generate, log and notify Telegram, but make NO outward
# call. Leave at 1 until this agent has completed a full supervised run.
DRY_RUN=1
DISPLAY_TZ=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════════════════
# Agent-specific
# ═══════════════════════════════════════════════════════════════════════════

# ── Which platforms are live ──
# A platform not listed is skipped cleanly: no error, no alert, no
# half-published run. This is how the agent ships TODAY with two blocked.
#   instagram -> blocked: META_IG_BUSINESS_ACCOUNT_ID (FB<->IG link error)
#   linkedin  -> blocked: Community Management API in review
PLATFORMS_ENABLED=facebook,threads,instagram,devto,x,pinterest

# ── Meta (Facebook Page + Instagram) ──
META_APP_ID=1517372699674360
META_APP_SECRET=
META_PAGE_ID=1211000982102296
META_PAGE_ACCESS_TOKEN=
# TODO — BLOCKED. Needs the IG Business account linked to the Page, then:
# GET /{page-id}?fields=instagram_business_account
META_IG_BUSINESS_ACCOUNT_ID=
# Pinned. Meta deprecates Graph versions on a rolling ~2-year clock; an
# unpinned call starts failing on THEIR schedule, not yours.
META_GRAPH_VERSION=v26.0

# ── Threads ──
THREADS_APP_ID=1530368745771466
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=

# ── Instagram (separate app, Instagram Login path) ──
INSTAGRAM_APP_ID=1466885355472751
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_ACCESS_TOKEN=

# ── Messenger ──
# Not used by the publish pipeline. Kept with the Meta app credentials it
# belongs to — the token a future auto-reply feature would use.
MESSENGER_APP_ACCESS_TOKEN=

# ── LinkedIn Company Page (Community Management API) ──
LINKEDIN_CLIENT_ID=77utm85yydo1ek
LINKEDIN_CLIENT_SECRET=
# TODO — BLOCKED on the API review. Run the one-time OAuth flow as a Company
# Page admin once approved; the portal's token generator suffices for a
# single-company case (no sign-in page needed).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORG_ID=

# ── Image generation ──
HUGGINGFACE_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Blank lets HF pick the cheapest route, which also means the look drifts run
# to run. Pin a provider once the output character stabilises.
HF_IMAGE_PROVIDER=

# ── Brand mark (Pillow compositing) ──
# The site's REAL typeface. layout.tsx replaced Poppins with Google Sans Flex
# and calls Poppins "the site's biggest brand liability" — so a social image in
# Poppins would undo that on the most-seen surface WizCodes has.
# Fetched and verified by: python tools/fetch_brand_fonts.py
BRAND_FONT_PATH=assets/GoogleSansFlex-SemiBold.ttf
BRAND_FONT_REGULAR_PATH=assets/GoogleSansFlex-Regular.ttf
BRAND_FONT_MONO_PATH=assets/GoogleSansCode-Regular.ttf
BRAND_MARK_TEXT=wizcodes.site
BRAND_MARK_POSITION=top-left
BRAND_PRIMARY_HEX=#0B63F6

# ── Cadence ──
CONTENT_TYPES=founder_usp,case_study,testimonial,blog_teaser,comparison
MAX_POSTS_PER_WEEK=3

# ── Approval ──
# How long a drafted post may sit unanswered before the run is abandoned and
# the checkpoint released. NOT published on timeout — silence is never consent.
APPROVAL_TIMEOUT_HOURS=48

# ── Budget guard (core.spend_ledger) ──
MAX_IMAGES_PER_DAY=4
MAX_LLM_CALLS_PER_DAY=40
APPROVAL_MODE=notify_only
MANUAL_PLATFORMS=x,youtube,linkedin_personal
SYNDICATION_ENABLED=devto,pinterest
DEVTO_API_KEY=
HASHNODE_TOKEN=
PINTEREST_TOKEN=
GBP_ACCOUNT_ID=
SLIDES_PER_CAROUSEL=8
INSTAGRAM_USER_ID=28039031715721519
INSTAGRAM_API_BASE=https://graph.instagram.com/v23.0
GOOGLE_OAUTH_CLIENT_ID=80579058468-1b5d3d5he5jr5kf3gprgfq6et5t2t90s.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
PINTEREST_DOMAIN_VERIFY=
ANTHROPIC_VOICE_MODEL=claude-opus-4-8
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=1085508385126124329
PINTEREST_APP_ID=1598093
PINTEREST_REFRESH_TOKEN=
TAVILY_API_KEY=
LLM_PROVIDER=proxy
