# Secrets. `.env.example` is the tracked template — never the real file.
.env
.env.*
!.env.example

# Local-only
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.log

# Run output: rendered slides, showcase folders, drafts.
output/

# Cached clone of the site repo used for grounding.
site_repo/
.cache/

# Generated images never belong in the repo — they live in R2.
assets/generated/
